{
  "name": "motivational-video-automation",
  "description": "Automatically finds and displays motivational YouTube videos tailored to the selected LinkUp tab category, including Men, Women, Kids, and Workout Motivation, to keep each community space active, uplifting, and relevant.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "in_app_agent",
      "events": [
        "conversation_started"
      ],
      "agent_name": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "motivational_video_automation",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "weeklyDigest",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "weeklyDigest"
  }
}