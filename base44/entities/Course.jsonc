{
  "name": "Course",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Course name"
    },
    "code": {
      "type": "string",
      "description": "Course code (e.g. CS101)"
    },
    "professor": {
      "type": "string",
      "description": "Professor name"
    },
    "semester": {
      "type": "string",
      "description": "Semester (e.g. Fall 2026)"
    },
    "color": {
      "type": "string",
      "description": "Color tag for the course"
    },
    "syllabus_url": {
      "type": "string",
      "description": "URL of uploaded syllabus file"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about the course"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Course start date (extracted from syllabus)"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Course end date (extracted from syllabus)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed"
      ],
      "default": "active",
      "description": "Whether the course is active or completed"
    }
  },
  "required": [
    "name"
  ]
}